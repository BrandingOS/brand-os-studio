# Anthropic API key — required for the `claude` and `hybrid` engines.
ANTHROPIC_API_KEY=

# Claude model used by the vision engine.
BRAND_VISION_CLAUDE_MODEL=claude-opus-5

# Comma-separated origins allowed to call this service from a browser.
BRAND_VISION_CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Max long-edge (px) of the image sent to Claude.
BRAND_VISION_MAX_EDGE=1536

# Max accepted upload size in megabytes.
BRAND_VISION_MAX_UPLOAD_MB=15
