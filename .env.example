VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── AI ────────────────────────────────────────────────────────
# Anthropic is NOT a frontend variable. All AI runs through the
# `anthropic-proxy` Supabase Edge Function using the SERVER-side
# `ANTHROPIC_API_KEY` secret. Do NOT reintroduce VITE_ANTHROPIC_API_KEY —
# it must never be inlined into the browser bundle again.
VITE_GEMINI_API_KEY=                    # (still browser today — move server-side before launch)
VITE_ICONIFY_API_URL=https://api.iconify.design
VITE_GOOGLE_FONTS_API_KEY=

# ── Unsplash ──────────────────────────────────────────────────
# Access (client) key only. Used by the bento media picker and the
# UI Color System photo-swap popover. Sign up at unsplash.com/developers
# and paste your Access Key. Do NOT paste the Secret key — it's
# server-only.
VITE_UNSPLASH_ACCESS_KEY=

# ── Dev auth bypass ──────────────────────────────────────────
# Set to true to sign in as a local dev user and skip Supabase auth
# entirely (useful when the Supabase project is paused/unreachable).
# Only has any effect in `npm run dev` — dead-code-eliminated from
# production builds. Leave unset/false by default.
VITE_DEV_BYPASS_AUTH=false

# Brand Vision classifier service (brand-vision/) — auto-places onboarding uploads
VITE_BRAND_VISION_URL=http://localhost:8300
VITE_BRAND_VISION_ENGINE=custom
