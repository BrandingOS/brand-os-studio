VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Logo Maker ────────────────────────────────────────────────
# Keys below must move to Supabase Edge Functions before public launch.
# See docs/logo-maker/ADR-0001-scaffold.md §3 and CLAUDE.md §"Security constraint".
VITE_ANTHROPIC_API_KEY=sk-ant-…        # server-side in prod (Edge Function)
VITE_GEMINI_API_KEY=                    # server-side in prod (Edge Function)
VITE_ICONIFY_API_URL=https://api.iconify.design
VITE_GOOGLE_FONTS_API_KEY=

# ── Unsplash ──────────────────────────────────────────────────
# Access (client) key only. Used by the bento media picker and the
# UI Color System photo-swap popover. Sign up at unsplash.com/developers
# and paste your Access Key. Do NOT paste the Secret key — it's
# server-only.
VITE_UNSPLASH_ACCESS_KEY=

# ── Dev auth bypass ──────────────────────────────────────────
# Set to true to sign in as a local dev user and skip Supabase auth
# entirely (useful when the Supabase project is paused/unreachable).
# Only has any effect in `npm run dev` — dead-code-eliminated from
# production builds. Leave unset/false by default.
VITE_DEV_BYPASS_AUTH=false
