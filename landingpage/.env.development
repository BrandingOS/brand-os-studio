# Local development only (Vite loads this in `npm run dev`, never in a build).
#
# The landing's links into the product resolve against VITE_APP_URL
# (src/lib/appUrl.ts). On the demo deploy the product is the same origin,
# so the default is empty — but here the landing runs on its own dev
# server and the app is on 8080, so Log in and the hero hand-off need to
# be told where to go.
VITE_APP_URL=http://localhost:8080
